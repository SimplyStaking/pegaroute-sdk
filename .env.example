# E2E tests (`bun run test:e2e`). Copy this file to `.env` (gitignored) and fill it in. Unit tests (`bun test`) need none of it.
#
# What you need:
# 1. A running Pegaroute at PEGAROUTE_E2E_BASE_URL, e.g. started with `docker compose up -d --build`.
# 2. An operator login - the account created at bootstrap, or another operator.
# 3. An integration whose providers are configured: provider fees, THORChain/Maya affiliates and a Squid integrator ID.
#    A brand-new integration has none of these, so every quote returns no routes (PROVIDER_CONFIGURATION_ERROR).
#    Configure one in the Pegaroute UI (or reuse one that already is) and put its name below.
#
# Each run creates a fresh API key on that integration and revokes it at the end.

# Pegaroute API URL.
PEGAROUTE_E2E_BASE_URL=http://localhost:4000

# Operator login, used only to create (and then revoke) the API key.
PEGAROUTE_E2E_OPERATOR_EMAIL=
PEGAROUTE_E2E_OPERATOR_PASSWORD=

# Name of the integration with configured providers.
PEGAROUTE_E2E_INTEGRATION_NAME=development

# Origin of the Pegaroute web UI. Pegaroute only accepts operator changes from this origin.
PEGAROUTE_E2E_WEB_ORIGIN=http://localhost:4001

# Webhook tests: the integration's webhook secret (whsec_…). Pegaroute shows it only when it's created or rotated,
# so copy it from the UI once (rotate it there if you don't have it). Tests never rotate it.
PEGAROUTE_E2E_WEBHOOK_SECRET=

# Webhook tests run a local receiver on this port. Pegaroute reaches it at this host: host.docker.internal when
# Pegaroute runs in Docker Desktop, localhost when it runs directly on this machine. During the e2e test run, the receiver's URL is
# added to the integration's webhook URLs; the original list is restored afterwards.
PEGAROUTE_E2E_WEBHOOK_PORT=4010
PEGAROUTE_E2E_WEBHOOK_HOST=host.docker.internal
