{
  "name": "@pegaroute/sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for the Pegaroute cross-chain swap API",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimplyStaking/pegaroute-sdk.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.2.22",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "types": [
        "./dist/types.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsdown && tsc -p examples",
    "lint": "biome check .",
    "check:package": "bun run prepack && publint && attw --pack . --profile esm-only",
    "format": "biome check --write .",
    "test": "bun test",
    "test:node": "bun run build && node --test \"test/node/*.node.mjs\"",
    "test:e2e": "bun test --timeout 60000 --preload ./test/e2e/setup.ts ./test/e2e/*.e2e.ts",
    "test:e2e:examples": "tsdown && bun test --timeout 60000 ./examples/examples.e2e.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "hono": "^4.13.12",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "viem": "^2.57.2"
  }
}
